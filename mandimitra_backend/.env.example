# MandiMitra Backend Environment Configuration

PORT=5001

# Government of India Agmarknet / data.gov.in API Key
# Resource: Current Daily Price of Various Commodities from Various Markets (Mandi)
AGMARKNET_API_KEY=PASTE_YOUR_DATA_GOV_OR_AGMARKNET_API_KEY_HERE
DATA_GOV_API_KEY=PASTE_YOUR_DATA_GOV_OR_AGMARKNET_API_KEY_HERE

# Gemma 4 AI Provider Configuration (Google AI Studio / OpenAI Compatible Endpoint)
GEMMA_API_KEY=PASTE_YOUR_GEMMA_PROVIDER_API_KEY_HERE
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# Meta WhatsApp Cloud API Configuration
# When these are left empty or with placeholder values, the backend runs safely in DEMO MODE.
# In DEMO MODE, messages are simulated and marked as [SIMULATED — NOT SENT].
WHATSAPP_ACCESS_TOKEN=PASTE_META_WHATSAPP_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_META_WHATSAPP_PHONE_NUMBER_ID_HERE
WHATSAPP_TEST_RECIPIENT=919876543210
WHATSAPP_TEMPLATE_NAME=mandi_price_alert
WHATSAPP_LANGUAGE_CODE=en
WHATSAPP_API_VERSION=v22.0

# Rate-limit-aware Alert Polling Interval (in minutes, default: 30)
ALERT_CHECK_INTERVAL_MINUTES=30
